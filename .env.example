# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used for account deletion. Never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The address people use to open Many Hands (used in invitation links and emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email and text alerts (optional). Without these, alerts still appear inside Many Hands.
# Email via Resend (resend.com). Verify your domain there, then set the from address.
RESEND_API_KEY=
KIN_EMAIL_FROM=Many Hands <alerts@yourdomain.co.uk>
# Texts via Twilio (twilio.com). Use either a phone number / alphanumeric sender ID, or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=Many Hands
TWILIO_MESSAGING_SERVICE_SID=
# Protects the morning-email job. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=

# ---- AI helper (letters, guided setup, Ask Many Hands). Without it, those features fall back to simpler versions.
ANTHROPIC_API_KEY=

# ---- School email forwarding (optional). An inbound email service (e.g. Postmark) posts to
# /api/inbound/email?secret=KIN_INBOUND_SECRET. KIN_INBOUND_DOMAIN is the domain whose MX points at it.
KIN_INBOUND_DOMAIN=
KIN_INBOUND_SECRET=

# ---- Appointment recordings: speech to text (optional). Without it recordings are saved but not transcribed.
OPENAI_API_KEY=
