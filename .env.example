# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used for account deletion. Never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The address people use to open KIN (used in invitation links and emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
