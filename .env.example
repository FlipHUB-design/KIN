# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used for account deletion. Never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The address people use to open KIN (used in invitation links and emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email and text alerts (optional). Without these, alerts still appear inside KIN.
# Email via Resend (resend.com). Verify your domain there, then set the from address.
RESEND_API_KEY=
KIN_EMAIL_FROM=KIN <alerts@yourdomain.co.uk>
# Texts via Twilio (twilio.com). Use either a phone number / alphanumeric sender ID, or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=KIN
TWILIO_MESSAGING_SERVICE_SID=
# Protects the morning-email job. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
